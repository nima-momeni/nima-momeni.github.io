---
import Base from '../layouts/Base.astro';
import { profile, projects } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${profile.name} — Engineering Portfolio`}>
 <section class="hero"><div class="eyebrow"><span class="online-dot"></span>{profile.role} · {profile.location}</div>
 <h1>{profile.headline}</h1><p class="hero-copy">{profile.summary}</p>
 <div class="actions"><a class="button button-primary" href="#projects">Explore projects <span>↗</span></a><a class="button button-secondary" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span>↗</span></a></div>
 <div class="hero-meta"><span>FOCUS AREAS</span><span>Embedded systems / Automation / Analog electronics</span></div></section>
 <section id="projects" class="section"><div class="section-head"><div><div class="eyebrow">SELECTED WORK / 01</div><h2>Projects that tell the story.</h2></div><p>Each project focuses on the problem, the engineering process, and what actually worked.</p></div>
 <div class="projects">{projects.map((project,i)=><a class="project-card" href={`${base}/projects/${project.slug}`}><div class={`project-art art-${i%3} ${project.cover ? 'has-photo' : ''}`} aria-hidden="true">{project.cover ? <img src={`${base}/${project.cover}`} alt="" loading={i === 0 ? 'eager' : 'lazy'} /> : <div class="art-shape"></div>}<span>{String(i+1).padStart(2,'0')}</span><small>{project.category}</small></div><div class="project-bottom"><div><div class="project-category">{project.category} · {project.year}</div><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.tags.map(tag=><span>{tag}</span>)}</div></div><span class="arrow">↗</span></div></a>)}</div></section>
 <section class="contact-strip"><div><div class="eyebrow">LET'S CONNECT</div><h2>Interested in working together?</h2></div><a class="button button-primary" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn ↗</a></section>
</Base>
